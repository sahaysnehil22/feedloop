# Copy to .env.local and fill in from the Firebase console
# (Project Settings -> Your apps -> Web app config).
# NEVER commit .env.local (gitignored).

# Firebase web config (public keys, safe for client code).
NEXT_PUBLIC_FIREBASE_API_KEY=AIza...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:abcdef...

# Server-only: service-account JSON (single line) for the public API routes.
# Project Settings -> Service accounts -> Generate new private key.
# NEVER commit this value. Set it as a Vercel env var; for local dev keep it
# in .env.local only (gitignored).
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}

# Demo project public key (pk_...) shown on the landing page as a live demo.
# Create the demo project in the dashboard, copy its public key, set it here
# and on Vercel, then redeploy.
NEXT_PUBLIC_DEMO_KEY=

# Public origin of this app, used to build the install snippet.
# e.g. https://feedloop-sahay-snehils-projects.vercel.app (http://localhost:3000 for local dev)
NEXT_PUBLIC_APP_URL=http://localhost:3000
